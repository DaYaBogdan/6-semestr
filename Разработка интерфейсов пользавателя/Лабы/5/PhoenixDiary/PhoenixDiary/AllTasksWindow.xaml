<Window x:Class="PhoenixDiary.AllTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Все записи – PhoenixDiary" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddButton" 
                    Click="OpenAddModal_Click"
                    Margin="0,0,10,0" 
                    Padding="10,8"
                    Width="100">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                    <TextBlock Text="+" Margin="5,0,0,0" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Button x:Name="DeleteButton" 
                    Click="DeleteSelectedTasks_Click"
                    Margin="0,0,10,0" 
                    Padding="10,8"
                    Width="100"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                    <TextBlock Text="🗑️" Margin="5,0,0,0" FontSize="12"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="SelectedCountText" 
                       Text="Выбрано: 0" 
                       VerticalAlignment="Center" 
                       Margin="20,0,0,0" 
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Разделитель -->
        <Separator Grid.Row="1" Margin="0,0,0,10"/>

        <!-- Еженедельник -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Заголовки дней недели -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ПН" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="ВТ" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="СР" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="3" Text="ЧТ" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="4" Text="ПТ" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="5" Text="СБ" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                    <TextBlock Grid.Column="6" Text="ВС" FontWeight="Bold" TextAlignment="Center" FontSize="14"/>
                </Grid>

                <!-- Дни недели с задачами -->
                <ItemsControl x:Name="WeekDaysControl" ItemsSource="{Binding WeekDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0.5" Margin="2" Padding="5" Background="White">
                                <StackPanel>
                                    <!-- Дата -->
                                    <TextBlock Text="{Binding FormattedDate}" FontSize="12" TextAlignment="Center" Foreground="Gray"/>
                                    <Separator Margin="0,5"/>

                                    <!-- Список задач -->
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,3" Padding="5" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Чекбокс выбора -->
                                                        <CheckBox Grid.Column="0" 
                                                                  IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,2,10,0"/>

                                                        <!-- Информация о задаче -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontWeight="Bold" Text="{Binding ClientName}" FontSize="12"/>
                                                            <TextBlock Text="{Binding ServiceName}" FontSize="10" Foreground="Gray"/>
                                                            <TextBlock Text="{Binding TimeRange}" FontSize="10" Foreground="DarkGreen"/>
                                                            <TextBlock Text="{Binding MasterName}" FontSize="10" Foreground="#2C3E50" FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Если нет задач -->
                                    <TextBlock Text="Нет записей" 
                                               Foreground="#999" 
                                               FontSize="10" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,10"
                                               Visibility="{Binding HasNoTasks}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Индикатор загрузки -->
                <Border x:Name="LoadingPanel" Visibility="Collapsed" Background="#F9F9F9" Padding="40">
                    <TextBlock Text="Загрузка..." HorizontalAlignment="Center" Foreground="#999" FontSize="14"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Навигация по неделям -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="PrevWeekButton" Click="PrevWeek" Content="← Предыдущая" Margin="5" Padding="10,5"/>
            <Button x:Name="ResetTodayButton" Click="ResetToToday" Content="Вернуться" Margin="5" Padding="10,5"/>
            <Button x:Name="NextWeekButton" Click="NextWeek" Content="Следующая →" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>