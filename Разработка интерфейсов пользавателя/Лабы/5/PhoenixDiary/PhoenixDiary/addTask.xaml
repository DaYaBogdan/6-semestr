<Window x:Class="PhoenixDiary.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление записи" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Дата и время:" Margin="0,0,0,5"/>
        <DatePicker x:Name="DatePicker" Grid.Row="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Клиент:" Margin="0,0,0,5"/>
        <ComboBox x:Name="ClientComboBox" Grid.Row="3" DisplayMemberPath="Name" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Услуга:" Margin="0,0,0,5"/>
        <ComboBox x:Name="ServiceComboBox" Grid.Row="5" DisplayMemberPath="Name" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Text="Мастер:" Margin="0,0,0,5"/>
        <ComboBox x:Name="MasterComboBox" Grid.Row="6" DisplayMemberPath="Name" Margin="0,26,0,-6"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"/>
        <Button x:Name="CancelButton" Click="Cancel_Click" Content="Отмена" Padding="15,5" RenderTransformOrigin="0.484,0.506" Margin="133,132,133,-132" Grid.Row="6"/>
        <Button x:Name="SaveButton" Click="Save_Click" Content="Сохранить" Padding="15,5" IsDefault="True" Margin="254,132,0,-132" Grid.Row="6"/>
    </Grid>
</Window>