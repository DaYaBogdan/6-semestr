<UserControl x:Class="PhoenixDiary.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="250">

	<Border Background="#2C3E50" CornerRadius="0,10,10,0">
		<StackPanel>
			<!-- Логотип -->
			<Border Height="80" Background="#1A252F" CornerRadius="0,10,0,0">
				<TextBlock Text="📓" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
			</Border>

			<!-- Кнопка Главная -->
			<Button x:Name="DiaryButton"
                    Click="DiaryButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,12"
                    HorizontalContentAlignment="Left">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="📅" FontSize="18" Width="30" TextAlignment="Center"/>
					<TextBlock Text="Главная" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14"/>
				</StackPanel>
			</Button>

			<!-- Кнопка Клиенты -->
			<Button x:Name="ClientsButton"
                    Click="ClientsButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,12"
                    HorizontalContentAlignment="Left">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="👥" FontSize="18" Width="30" TextAlignment="Center"/>
					<TextBlock Text="Клиенты" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14"/>
				</StackPanel>
			</Button>

			<!-- Кнопка Мастера -->
			<Button x:Name="MastersButton"
                    Click="MastersButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,12"
                    HorizontalContentAlignment="Left">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="👤" FontSize="18" Width="30" TextAlignment="Center"/>
					<TextBlock Text="Мастера" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14"/>
				</StackPanel>
			</Button>

			<!-- Кнопка Все записи -->
			<Button x:Name="AllTasksButton"
                    Click="AllTasksButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,12"
                    HorizontalContentAlignment="Left">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="📋" FontSize="18" Width="30" TextAlignment="Center"/>
					<TextBlock Text="Все записи" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14"/>
				</StackPanel>
			</Button>

			<!-- Разделитель -->
			<Separator Background="#34495E" Margin="15,20,15,15"/>

			<!-- Кнопка Выход -->
			<Button x:Name="LogoutButton"
                    Click="LogoutButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,12"
                    HorizontalContentAlignment="Left">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="🚪" FontSize="18" Width="30" TextAlignment="Center"/>
					<TextBlock Text="Выход" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="14"/>
				</StackPanel>
			</Button>
		</StackPanel>
	</Border>
</UserControl>