<Window x:Class="MangaReader.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MangaReader"
        mc:Ignorable="d"
        Title="FavoritesWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Моё избранное" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListBox Grid.Row="1" Name="FavoritesListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="placeholder.png" Width="60" Height="80" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Название тайтла" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Автор: ..." Foreground="Gray"/>
                            </StackPanel>
                            <Button Content="Удалить" Grid.Column="2" Margin="10,0" Width="80"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBoxItem>
               
            </ListBoxItem>
            <ListBoxItem>
                
            </ListBoxItem>
        </ListBox>

        <TextBlock Grid.Row="1" Text="Избранное пусто. Добавьте тайтлы через карточку." 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

    </Grid>
</Window>
