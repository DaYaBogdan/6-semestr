<Window x:Class="MangaReader.TitleCardWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка тайтла" Height="600" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Название тайтла" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="В любимое" Margin="20,0,0,0" Padding="10,5" Background="Gold"/>

        </StackPanel>


        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Теги: тег1, тег2" Margin="0,2"/>
                <TextBlock Text="Автор: Имя Автора" Margin="0,2"/>
                <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,10,0,2"/>
                <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit..." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,10,0" Background="#FAFAFA" Padding="10">
                <StackPanel>
                    <TextBlock Text="Главы" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Height="200">
                        <ListBoxItem>Глава 1</ListBoxItem>
                        <ListBoxItem>Глава 2</ListBoxItem>
                        <ListBoxItem>Глава 3</ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>
            <!-- Правая часть: комментарии -->
            <Border Grid.Column="1" Background="#FAFAFA" Padding="10">
                <StackPanel>
                    <TextBlock Text="Комментарии" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Height="200">
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Пользователь1" FontWeight="Bold"/>
                                <TextBlock Text="чето то там" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Пользователь2" FontWeight="Bold"/>
                                <TextBlock Text="текст" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <TextBox Margin="0,10,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Content="Добавить комментарий" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>


        <Button Grid.Row="3" Content="Читать первую главу" Width="150" HorizontalAlignment="Right" Margin="0,15,0,0"/>
    </Grid>
</Window>