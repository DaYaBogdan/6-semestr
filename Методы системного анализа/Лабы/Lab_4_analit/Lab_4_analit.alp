					<Properties Source="1779895419778" Target="1779895419780" Trigger="condition">
						<Action><![CDATA[//remove a token from each input place
for( Place pl : inputPlaces ) {
	pl.tokens--;
	pl.inform();
}]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
