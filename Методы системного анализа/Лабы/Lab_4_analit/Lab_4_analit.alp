						<Point><X>0</X><Y>-50</Y></Point>
					</Points>
					<IconOffset>49.0</IconOffset>
					<Properties Source="1779895419780" Target="1779895419778" Trigger="timeout">
						<Action><![CDATA[//put a token in each output place
for( Place pl : outputPlaces ) {
	pl.tokens++;
	pl.inform();
}
//increase fire count
fireCount++;]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[delayTime()]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
